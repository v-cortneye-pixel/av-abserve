# =============================================================================
# av-observe environment template
#
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Loaded by shared/credentials.js (path: ../.env relative to shared/).
#
# Variables marked [required-by:<type>] are required when the matching
# getCredentials(type) call is made. Variables marked [optional] only affect
# specific code paths.
# =============================================================================

# ---- Zoom API -------------------------------------------------- [required-by:zoom]
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Q-SYS HTTP API ------------------------------------------- [required-by:qHttp]
QSYS_USERNAME=
QSYS_PASSWORD=

# ---- Q-SYS Remote Control (QRC) --------------------------------- [required-by:qrc]
QRC_USERNAME=
QRC_PIN=

# ---- Q-SYS Reflect API ---------------------------------------- [required-by:qrem]
QSYS_TOKEN=

# ---- Slack ----------------------------------------------------- [required-by:slack]
SLACK_BOT_TOKEN=

# ---- Splunk HTTP Event Collector ----------------------------- [required-by:splunk]
SPLUNK_TOKEN=

# ---- Domotz API ---------------------------------------------- [required-by:domotz]
DOMOTZ_KEY=

# ---- Juniper switch management ----------------------------- [required-by:juniper]
JUNIPER_USERNAME=
JUNIPER_PASSWORD=

# ---- Google service account (Sheets: IP schedule + error KB) - [required-by:google]
# Newlines in GOOGLE_KEY may be escaped as \n; credentials.js will unescape them.
GOOGLE_KEY=
GOOGLE_CLIENT_EMAIL=

# ---- Google Calendar service account ------------ [required-by:googleCalendar]
GOOGLE_CALENDAR_KEY=
GOOGLE_CALENDAR_CLIENT_EMAIL=

# ---- Google Meet / Admin SDK ------------------------ [required-by:googleMeet]
GOOGLE_ADMIN_KEY=
GOOGLE_ADMIN_CLIENT_EMAIL=
GOOGLE_ADMIN_EMAIL=
GOOGLE_CUSTOMER_ID=

# ---- Microsoft Graph ------------------------------- [required-by:microsoft]
MICROSOFT_SECRET_VALUE=
# Optional: override the Azure App Registration client_id. If unset,
# shared/credentials.js falls back to the historical hardcoded value.
# MICROSOFT_CLIENT_ID=

# =============================================================================
# Optional runtime flags
# =============================================================================

# Run the daily update against the test Slack channel and skip Splunk writes.
# Any of the following triggers test mode (back-compat: 'mode' kept for
# existing cron jobs and CI definitions):
# mode=testing
# AV_OBSERVE_MODE=testing
# NODE_ENV=test

# Skip resource-intensive operations within the daily update.
# slim=true

# Skip Slack reporting; only update Splunk.
# splunk_only=true

# Force write paths to ./.data instead of ./.ignore (used in CI).
# CI=true
# GITLAB_CI=true

# =============================================================================
# av-alerts-api (Lambda) only
# =============================================================================
# These are managed via AWS KMS-encrypted environment variables on the Lambda
# itself (see shared/cloud-credentials.js). They are NOT loaded from .env at
# runtime; this section is documentation only.
#
# AWS_REGION=us-west-2
# AWS_LAMBDA_FUNCTION_NAME=av-alerts-api
